# Compare full multisets, including identical NULL rows and an empty result.

statement ok
CREATE TABLE baseline (id INTEGER, value INTEGER);

statement ok
INSERT INTO baseline VALUES (1, NULL), (1, NULL), (2, 7);

statement ok
CREATE TABLE actual AS SELECT * FROM baseline;

query II rowsort matches
SELECT id, value FROM baseline WHERE id <= 2;
----

query II rowsort matches
SELECT id, value FROM actual WHERE id <= 2;
----

statement ok
DELETE FROM actual WHERE id <= 2;

query II rowsort survivors
SELECT id, value FROM baseline WHERE (id <= 2) IS NOT TRUE;
----

query II rowsort survivors
SELECT id, value FROM actual;
----
